/** app.wxss (global styles) **/
/* 现有内容保留在下方注释线之上，以下为新增全局工具类 */
/* ========== Global Button Utilities ========== */
/* 父容器居中：请优先让外层容器使用该类，实现规范的 flex 居中 */
.btn-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 固定宽度按钮基类：若需不同宽度，可复制此类改名为 btn-fixed-XXX 并调整宽度 */
.btn-fixed-690 {
  width: 690rpx !important;
  flex: 0 0 690rpx;
  box-sizing: border-box;
}

/* 若未来统一固定宽度按钮尺寸，可改为通用类（示例，默认 690rpx）
.btn-fixed {
  width: 690rpx !important;
  flex: 0 0 690rpx;
  box-sizing: border-box;
}
*/

/* 建议：按钮本体内部内容居中 */
.btn-flex {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 说明：
1) 使用规范：
  - 外层容器加 .btn-center，按钮本体可加 .btn-flex 居中文本/图标
  - 需要固定按钮宽度时，加 .btn-fixed-690（或你自定义的固定宽度类）
2) 不直接全局覆盖 button 的宽度，避免破坏“应为通栏”的按钮（如登录、提交等 100% 宽按钮）
*/