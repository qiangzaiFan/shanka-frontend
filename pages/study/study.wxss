/* pages/study/study.wxss */
.container {
  display: flex;
  flex-direction: column;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #07C160 0%, #38d9a9 100%);
  color: white;
  padding: 40rpx;
  text-align: center;
}

.header-date {
  display: flex;
  justify-content: space-around;
  align-items: center;
  font-size: 36rpx;
}

.arrow {
  padding: 10rpx 20rpx;
  font-weight: bold;
}

.calendar {
  background-color: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.week-days {
  display: flex;
  justify-content: space-around;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  color: #999;
  font-size: 28rpx;
}

.days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  margin-top: 20rpx;
}

.day-item {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 80rpx;
  font-size: 30rpx;
}

.day-text {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 50%;
}

.day-item.today .day-text {
  background-color: #e6f7ff;
  color: #1890ff;
  font-weight: bold;
}

.day-item.checked .day-text {
  background-color: #07C160;
  color: #fff;
}

.stats {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  margin: 20rpx 30rpx;
  padding: 30rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.stat-item .stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.stat-item .stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.action-area {
  padding: 40rpx;
  margin-top: auto;
}

.check-in-btn {
  background-color: #07C160;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
}

.check-in-btn.disabled {
  background-color: #a0e6c2;
  color: #fff;
}