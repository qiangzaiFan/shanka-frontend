<!--pages/study/study.wxml-->
<view class="container">
  <view class="header">
    <view class="header-date">
      <view class="arrow" bindtap="handlePrevMonth"> &lt; </view>
      <view>{{year}}年 {{month}}月</view>
      <view class="arrow" bindtap="handleNextMonth"> &gt; </view>
    </view>
  </view>

  <view class="calendar">
    <view class="week-days">
      <view class="day" wx:for="{{weekDays}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="days">
      <view class="day-item {{item.isToday ? 'today' : ''}} {{item.isChecked ? 'checked' : ''}}" wx:for="{{days}}" wx:key="date">
        <view class="day-text">{{item.day}}</view>
      </view>
    </view>
  </view>

  <view class="stats">
    <view class="stat-item">
      <view class="stat-value">{{totalCheckIns}}</view>
      <view class="stat-label">累计打卡</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{consecutiveCheckIns}}</view>
      <view class="stat-label">连续打卡</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{monthBest}}</view>
      <view class="stat-label">本月最佳</view>
    </view>
  </view>

  <view class="action-area">
    <button class="check-in-btn {{isTodayCheckedIn ? 'disabled' : ''}}" bindtap="handleCheckIn" disabled="{{isTodayCheckedIn}}">
      {{isTodayCheckedIn ? '今日已打卡' : '今日打卡'}}
    </button>
  </view>
</view>