/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: #f8f8f8;
  padding: 0 60rpx; /* 30px side padding */
  box-sizing: border-box;
}

/* 头部区域 */
.header-section {
  padding-top: 226rpx; /* 113px */
  padding-bottom: 90rpx; /* 45px */
  text-align: center;
}

.title {
  font-size: 48rpx; /* 24px */
  font-weight: 400;
  color: #333333;
  margin-bottom: 10rpx; /* 5px */
}

.subtitle {
  font-size: 32rpx; /* 16px */
  color: #888888;
  font-weight: 400;
}

/* 表单区域 */
.form-section {
  width: 100%;
}

/* 输入框组 */
.input-group {
  margin-bottom: 30rpx; /* 15px */
}

.input-group:last-of-type {
  margin-bottom: 0;
}

.input-field {
  width: 100%;
  height: 100rpx; /* 50px */
  background: #ffffff;
  border: none;
  border-radius: 10rpx; /* 5px */
  padding: 0 28rpx; /* 14px */
  font-size: 32rpx; /* 16px */
  color: #333;
  box-sizing: border-box;
}

.input-field::placeholder {
  color: #cccccc;
  font-size: 32rpx; /* 16px */
}

/* 登录按钮 */
.login-btn-wrapper {
  margin-top: 90rpx; /* 45px */
  margin-bottom: 18rpx; /* 9px */
  width: 100%;
}

.login-btn {
  width: 100% !important;
  height: 90rpx; /* 45px */
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 10rpx; /* 5px */
  font-size: 32rpx; /* 16px */
  font-weight: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 90rpx;
}

.login-btn::after {
  border: none;
}

/* 忘记密码区域 */
.forget-section {
  text-align: center;
}

.forget-text {
  font-size: 24rpx; /* 12px */
  color: #888888;
}
