/* pages/add-card/add-card.wxss */
.add-card-container {
  min-height: 100vh;
  background: #F8F8F8;
  padding-bottom: 130rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.header {
  background: #FFFFFF;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 1rpx solid #E5E5E5;
}

.back-icon {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 10rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 400;
  color: #000000;
}

.section-header {
  font-size: 24rpx;
  color: #888888;
  padding: 26rpx 28rpx;
}

/* 单词输入 */
.word-input-section {
  background: #FFFFFF;
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 110rpx;
  box-sizing: border-box;
}

.word-input {
  font-size: 32rpx;
  color: #333;
  flex: 1;
}

.word-input::placeholder {
  color: #CCCCCC;
}

.word-tip {
  font-size: 24rpx;
  color: #888888;
}

/* 图片上传 */
.image-upload-section {
  background: #FFFFFF;
  padding: 30rpx 28rpx;
  height: 170rpx;
  box-sizing: border-box;
}

.image-uploader {
  width: 120rpx;
  height: 120rpx;
  border: 1rpx dashed #DCDFE6;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 释义与例句 */
.definition-section {
  background: #FFFFFF;
  padding: 0 28rpx;
  height: 300rpx;
  box-sizing: border-box;
}

.definition-group {
  padding: 20rpx 0;
}

.definition-label {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.definition-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  height: 60rpx;
}

.definition-textarea::placeholder {
  color: #CCCCCC;
  font-size: 28rpx;
}

.divider {
  height: 1rpx;
  background-color: #F8F8F8;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #FFFFFF;
  padding: 20rpx 0;
}

.save-btn-wrapper {
  padding: 0 30rpx;
}

.save-btn {
  width: 100%;
  height: 90rpx;
  background: #07C160;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 32rpx;
}