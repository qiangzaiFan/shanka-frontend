<!-- pages/profile/profile.wxml -->
<form bindsubmit="saveProfile">
  <view class="page">
    <!-- 家长信息 -->
    <view class="section-title">家长信息</view>
    <view class="card">
      <view class="cell" bind:tap="changeAvatar" data-type="parent">
        <text class="label">头像</text>
        <view class="value-container">
          <image class="avatar" src="{{parentAvatar}}" mode="aspectFill" />
          <view class="chevron"></view>
        </view>
      </view>
      <view class="divider"></view>
      <view class="cell">
        <text class="label">昵称</text>
        <view class="value-container">
          <input name="parentName" class="input" value="{{parentName}}" placeholder="请输入昵称" placeholder-class="input-placeholder" />
          <view class="chevron"></view>
        </view>
      </view>
      <view class="divider"></view>
      <view class="cell">
        <text class="label">手机号</text>
        <view class="value-container">
          <text class="value-text">{{parentPhone}}</text>
        </view>
      </view>
      <view class="divider"></view>
      <view class="cell">
        <text class="label">注册时间</text>
        <view class="value-container">
          <text class="value-text">{{registerDate}}</text>
        </view>
      </view>
    </view>

    <!-- 孩子信息 -->
    <view class="section-title">孩子信息</view>
    <view class="card">
      <view class="cell" bind:tap="changeAvatar" data-type="child">
        <text class="label">孩子头像</text>
        <view class="value-container">
          <image class="avatar" src="{{childAvatar}}" mode="aspectFill" />
          <view class="chevron"></view>
        </view>
      </view>
      <view class="divider"></view>
      <view class="cell">
        <text class="label">孩子昵称</text>
        <view class="value-container">
          <input name="childName" class="input" value="{{childName}}" placeholder="请输入孩子昵称" placeholder-class="input-placeholder" />
          <view class="chevron"></view>
        </view>
      </view>
      <view class="divider"></view>
      <picker mode="date" value="{{birthDate}}" bindchange="bindDateChange">
        <view class="cell">
          <text class="label">出生日期</text>
          <view class="value-container">
            <text class="value-text">{{birthDate}}</text>
            <view class="chevron"></view>
          </view>
        </view>
      </picker>
      <view class="divider"></view>
      <view class="cell">
        <text class="label">性别</text>
        <view class="value-container">
          <view class="gender-selector">
            <view class="gender-option {{gender === 'male' ? 'active' : ''}}" data-value="male" bind:tap="setGender">男</view>
            <view class="gender-option {{gender === 'female' ? 'active' : ''}}" data-value="female" bind:tap="setGender">女</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 保存区域 -->
    <view class="save-area">
      <button class="save-btn" form-type="submit">保存修改</button>
    </view>
  </view>
</form>