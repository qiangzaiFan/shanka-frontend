/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background: #F8F8F8; /* fill_BTXXCZ */
  box-sizing: border-box;
}

/* 白色卡片区块 */
.section {
  margin-top: 20rpx;
  background: #FFFFFF; /* fill_HFG5MX */
  padding: 0 30rpx;     /* 左右 15px → 30rpx */
}

/* 区块标题（家长信息/孩子信息） */
.section-title {
  font-size: 24rpx;   /* 12px, style_3W3563 */
  color: #888888;     /* fill_NYP4GZ */
  line-height: 1.4;
  padding-top: 24rpx;
  padding-bottom: 16rpx;
}

/* 单行条目 */
.cell {
  height: 110rpx; /* 贴近设计的行高与手感 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative; /* 用于右侧箭头绝对定位 */
}

/* 头像条目稍高一些 */
.avatar-cell {
  height: 120rpx;
}

/* 左侧标签与右侧值 */
.label {
  font-size: 32rpx; /* 16px, style_FXTO29 */
  color: #333333;   /* fill_L8T0F3 */
}

.value {
  font-size: 32rpx; /* 16px */
  color: #333333;
  margin-left: auto;     /* 推到右侧 */
  text-align: right;     /* 文本靠右 */
  padding-right: 90rpx;  /* 箭头left=70rpx，预留G=20rpx → 90rpx */
  box-sizing: border-box;
}

/* 灰色分割线 */
.divider {
  height: 2rpx;          /* stroke_U445LL 1px → 2rpx */
  background: #F0F2F5;   /* stroke_U445LL */
}

/* 右侧箭头（chevron） */
.chevron {
  width: 20rpx;   /* 10px */
  height: 20rpx;  /* 10px */
  border-right: 2rpx solid #CCCCCC;  /* stroke_D900AS */
  border-bottom: 2rpx solid #CCCCCC;
  transform: rotate(-45deg);
  position: absolute;
  right: 20rpx;   /* 按设计约25px→50rpx */
  top: 50%;
  transform: translateY(-50%) rotate(-45deg);
}

/* 头像圆形占位 */
.avatar-circle {
  width: 80rpx;   /* 40px, layout_RHW8V3 & O3ON3S */
  height: 80rpx;
  background: #E0E0E0; /* fill_IQ543Y */
  border-radius: 50%;
  margin-left: auto;
  margin-right: 90rpx; /* 与箭头保持统一留白（G=20rpx） */
}

/* 性别分段选择 */
.gender-cell {
  justify-content: flex-start;
  gap: 30rpx;
}

.seg {
  margin-left: auto;
  display: flex;
  align-items: center;
}

.seg-item {
  width: 90rpx;     /* 45px → 90rpx */
  height: 60rpx;    /* 30px → 60rpx */
  border-radius: 10rpx; /* 5px → 10rpx */
  background: #F0F2F5;  /* fill_OUYOGQ */
  color: #333333;
  font-size: 28rpx; /* 14px → 28rpx */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.seg-item.active {
  background: #07C160; /* fill_0VRU3W */
  color: #FFFFFF;
}

/* 底部保存区域 */
.save-area {
  background: #FFFFFF;       /* layout_AEF1QG 区域 */
  padding: 20rpx 0;
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.save-btn {
    display: flex;
    align-items: center;
    justify-content: center;
  width: 690rpx !important; /* 防止被内置 button 样式覆盖 */
  height: 90rpx;            /* 45px → 90rpx */
  line-height: 90rpx;
  background: #07C160;
  color: #FFFFFF;
  border: none;
  border-radius: 10rpx;     /* 5px → 10rpx */
  font-size: 32rpx;         /* 16px */
  flex: 0 0 690rpx;         /* 进一步锁定宽度（可选） */
  box-sizing: border-box;
}

.save-btn::after {
  border: none;
}