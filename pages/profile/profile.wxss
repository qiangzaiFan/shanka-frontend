/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background: #f8f8f8;
  box-sizing: border-box;
  padding-bottom: 160rpx; /* 为保存按钮区域预留空间 */
}

.section-title {
  font-size: 24rpx;
  color: #888888;
  padding: 24rpx 30rpx 16rpx;
}

.card {
  background: #ffffff;
  padding-left: 30rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 110rpx;
  padding-right: 30rpx;
}

.divider {
  height: 1rpx;
  background: #f0f2f5;
  margin-left: 30rpx;
}
.card .cell:last-child + .divider {
  display: none;
}

.label {
  font-size: 32rpx;
  color: #333333;
}

.value-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.chevron {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #cccccc;
  border-right: 3rpx solid #cccccc;
  transform: rotate(45deg);
}

.input {
  text-align: right;
  font-size: 32rpx;
  color: #333333;
}

.input-placeholder {
  color: #bbbbbb;
}

.value-text {
  font-size: 32rpx;
  color: #333333;
}

.gender-selector {
  display: flex;
  gap: 20rpx;
}

.gender-option {
  width: 90rpx;
  height: 60rpx;
  border-radius: 8rpx;
  background: #f0f2f5;
  color: #333333;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gender-option.active {
  background: #07c160;
  color: #ffffff;
}

.save-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  z-index: 100;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 10rpx;
  font-size: 32rpx;
}

.save-btn::after {
  border: none;
}
