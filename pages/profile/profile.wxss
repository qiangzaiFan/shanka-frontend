/* pages/profile/profile.wxss */
.profile-container {
  min-height: 100vh;
  background: #F8F8F8;
}

/* 页面标题 */
.header {
  background: #FFFFFF;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #EFEFEF;
}

.header-title {
  font-size: 36rpx; /* 18px */
  font-weight: 400;
  color: #000000;
}

/* 用户信息区域 */
.user-section {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 34rpx 36rpx; /* 17px 18px */
  margin-top: 18rpx; /* 9px */
}

.avatar-wrapper {
  width: 80rpx; /* 40px */
  height: 80rpx; /* 40px */
  margin-right: 28rpx; /* 14px */
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #f0f0f0;
}

.user-details {
  flex: 1;
}

.username {
  font-size: 36rpx; /* 18px */
  font-weight: 400;
  color: #333333;
  margin-bottom: 6rpx; /* 3px */
}

.user-meta {
  font-size: 24rpx; /* 12px */
  color: #888888;
}

/* 功能菜单 */
.menu-section {
  background: #FFFFFF;
  margin-top: 20rpx; /* 10px */
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 36rpx; /* 17px 18px */
  border-bottom: 1rpx solid #F0F2F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 32rpx; /* 16px */
  color: #333333;
}

/* 退出登录 */
.logout-section {
  margin-top: 20rpx; /* 10px */
}

.logout-btn {
  width: 100%;
  height: 110rpx; /* 55px */
  background: #FFFFFF;
  color: #F56C6C;
  border: none;
  border-radius: 0;
  font-size: 32rpx; /* 16px */
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn::after {
  border: none;
}

.arrow-icon {
  display: flex;
  align-items: center;
}