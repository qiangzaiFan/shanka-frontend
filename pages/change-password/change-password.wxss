/* pages/change-password/change-password.wxss */
.change-password-container {
  min-height: 100vh;
  background: #F8F8F8;
  padding-bottom: 130rpx; /* for footer */
  box-sizing: border-box;
}

/* 页面标题 */
.header {
  background: #FFFFFF;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 1rpx solid #E5E5E5;
}

.back-icon {
  position: absolute;
  left: 24rpx; /* 12px */
  top: 50%;
  transform: translateY(-50%);
  padding: 10rpx;
}

.header-title {
  font-size: 36rpx; /* 18px */
  font-weight: 400;
  color: #000000;
}

/* 提示区域 */
.tip-section {
  padding: 26rpx 28rpx; /* 13px 14px */
}

.tip-section .tip-text {
  font-size: 24rpx; /* 12px */
  color: #888888;
}

/* 表单区域 */
.form-section {
  background: #FFFFFF;
  padding: 0 28rpx; /* 14px */
}

.input-group {
  display: flex;
  align-items: center;
  height: 110rpx; /* 55px */
  border-bottom: 1rpx solid #F0F2F5;
}

.input-group:last-child {
  border-bottom: none;
}

.input-label {
  font-size: 32rpx; /* 16px */
  color: #333333;
  width: 160rpx; /* give it some space */
}

.input-field {
  flex: 1;
  font-size: 32rpx; /* 16px */
  color: #333;
}

.input-field::placeholder {
  color: #CCCCCC;
}

/* 密码提示 */
.password-tip {
  padding: 12rpx 28rpx; /* 6px 14px */
}

.password-tip .tip-text {
  font-size: 24rpx; /* 12px */
  color: #B2B2B2;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #FFFFFF;
  padding: 20rpx 0;
}

.submit-btn-wrapper {
  padding: 0 30rpx; /* 15px */
}

.submit-btn {
  width: 100%;
  height: 90rpx; /* 45px */
  background: #07C160;
  color: #fff;
  border: none;
  border-radius: 10rpx; /* 5px */
  font-size: 32rpx; /* 16px */
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after {
  border: none;
}