/**index.wxss**/
.container {
  min-height: 100vh;
  background: #F8F8F8;
}

/* 页面标题 */
.header {
  background: #FFFFFF;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #EFEFEF;
}

.header-title {
  font-size: 36rpx;
  font-weight: 400;
  color: #000000;
}

/* 词汇统计 */
.stats-section {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #FFFFFF;
  height: 140rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 400;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #888888;
}

.stat-divider {
  width: 1rpx;
  height: 80rpx;
  background-color: #F0F2F5;
}

/* 操作按钮 */
.actions-section {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #FFFFFF;
  padding: 20rpx 0;
  margin-top: 18rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #333333;
}

.action-text {
  margin-top: 10rpx;
}

/* 搜索栏 */
.search-section {
  padding: 20rpx 26rpx;
  background: #FFFFFF;
  margin-top: 18rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #F8F8F8;
  border-radius: 36rpx;
  padding: 0 20rpx;
  height: 72rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 10rpx;
}

/* 闪卡列表 */
.list-section {
  margin-top: 18rpx;
  background: #FFFFFF;
  padding: 0 24rpx;
}

.list-header {
  font-size: 24rpx;
  color: #888888;
  padding: 20rpx 0;
}

.card-list {
  padding-bottom: 20rpx;
}

.card-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.card-item:last-child {
  border-bottom: none;
}

.card-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background-color: #E0E0E0;
  margin-right: 20rpx;
}

.card-info {
  flex: 1;
}

.card-word {
  font-size: 36rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.card-date {
  font-size: 24rpx;
  color: #AAAAAA;
}

.card-actions .edit-btn {
  background-color: #ECF0F1;
  color: #34495E;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 25rpx;
  border: none;
  height: 50rpx;
  line-height: 30rpx;
}

.card-actions .edit-btn::after {
  border: none;
}