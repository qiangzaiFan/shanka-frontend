<!--index.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="header">
    <view class="header-title">闪卡管理</view>
  </view>

  <!-- 词汇统计 -->
  <view class="stats-section">
    <view class="stat-item">
      <view class="stat-value" style="color: #333333;">{{totalWords}}</view>
      <view class="stat-label">总词量</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-value" style="color: #27AE60;">{{newWords}}</view>
      <view class="stat-label">新词量</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-value" style="color: #E67E22;">{{oldWords}}</view>
      <view class="stat-label">旧词量</view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions-section">
    <view class="action-item" bindtap="addCard">
      <l-icon name="add" size="28" color="#3498DB"></l-icon>
      <text class="action-text">新增闪卡</text>
    </view>
    <view class="action-item" bindtap="batchAdd">
      <l-icon name="upload" size="28" color="#27AE60"></l-icon>
      <text class="action-text">批量新增</text>
    </view>
    <view class="action-item" bindtap="goToSettings">
      <l-icon name="setting" size="28" color="#34495E"></l-icon>
      <text class="action-text">闪卡设置</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-bar">
      <l-icon name="search" color="#BBBBBB" size="36"></l-icon>
      <input class="search-input" placeholder="按单词搜索..." value="{{keyword}}" bindinput="onSearchInput" />
    </view>
  </view>

  <!-- 闪卡列表 -->
  <view class="list-section">
    <view class="list-header">闪卡列表</view>
    <view class="card-list">
      <view class="card-item" wx:for="{{filteredCards}}" wx:key="id">
        <image class="card-image" src="{{item.image || '/images/default-card.png'}}" mode="aspectFill"></image>
        <view class="card-info">
          <view class="card-word">{{item.word}}</view>
          <view class="card-date">添加: {{item.date}}</view>
        </view>
        <view class="card-actions">
          <button class="edit-btn" bindtap="editCard" data-id="{{item.id}}">编辑</button>
        </view>
      </view>
    </view>
  </view>
</view>